# Copy to .env.local (never committed). mise loads it into every task.

# Internal URL of the Melvis REST API (your locally running melvis in development).
MELVIS_API_URL=http://localhost:8080/api
# Upstream timeout in milliseconds.
MELVIS_TIMEOUT_MS=5000
# Which environment's brand hosts to serve: local (default, *.localhost) | dev | pre | pro.
# Leave unset locally. Deployments set it (DEPLOYMENT.md).
# APP_ENV=local
# APP_VERSION is set when the image is built; locally /healthz shows 0.0.0-local.

# Localazy keys for i18n:upload / i18n:download (from the Localazy project settings).
LOCALAZY_READ_KEY=
LOCALAZY_WRITE_KEY=

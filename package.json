{
  "name": "melvis-satellite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=app",
    "e2e:local": "playwright test --project=local --pass-with-no-tests",
    "ds:tokens": "tsx scripts/ds-tokens.ts",
    "ds:check": "tsx scripts/ds-tokens.ts --check",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "i18n:upload": "localazy upload -w \"$LOCALAZY_WRITE_KEY\" -r \"$LOCALAZY_READ_KEY\"",
    "i18n:download": "localazy download -r \"$LOCALAZY_READ_KEY\" && prettier --write --log-level warn \"src/locales/*.json\"",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm ds:check && pnpm i18n:check"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@localazy/cli": "2.0.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.34.5"
}
